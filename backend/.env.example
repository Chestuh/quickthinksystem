APP_NAME=QuickThink
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_EXPIRATION=480

# Required before seeding the first administrator account.
ADMIN_NAME="QuickThink Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
